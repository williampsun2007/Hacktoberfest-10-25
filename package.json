{
  "name": "umd-events",
  "version": "0.1.0",
  "private": true,
  "description": "Imports the UMD campus events calendar (iCal feed) and displays it, with Gemini-powered tags and picks.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "snapshot": "node scripts/snapshot.js"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "express": "^5.3.0",
    "openai": "^7.43.0"
  }
}
